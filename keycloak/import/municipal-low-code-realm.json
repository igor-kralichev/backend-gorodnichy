{
  "realm": "municipal-low-code",
  "displayName": "Муниципальная low-code платформа",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "clientSessionIdleTimeout": 1800,
  "clientSessionMaxLifespan": 43200,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "Admin",
        "description": "Администратор платформы",
        "composite": true,
        "composites": {
          "realm": [
            "permission_read",
            "permission_create",
            "permission_update",
            "permission_archive",
            "permission_delete",
            "permission_manage_schema",
            "permission_manage_access",
            "permission_export",
            "permission_import",
            "permission_request",
            "permission_review",
            "permission_confirm"
          ]
        }
      },
      {
        "name": "User",
        "description": "Пользователь платформы"
      },
      {
        "name": "permission_read",
        "description": "Глобальное чтение данных"
      },
      {
        "name": "permission_create",
        "description": "Глобальное создание данных"
      },
      {
        "name": "permission_update",
        "description": "Глобальное изменение данных"
      },
      {
        "name": "permission_archive",
        "description": "Глобальное архивирование данных"
      },
      {
        "name": "permission_delete",
        "description": "Глобальное удаление данных"
      },
      {
        "name": "permission_manage_schema",
        "description": "Глобальное управление схемами"
      },
      {
        "name": "permission_manage_access",
        "description": "Глобальное управление доступом"
      },
      {
        "name": "permission_export",
        "description": "Глобальный экспорт данных"
      },
      {
        "name": "permission_import",
        "description": "Глобальный импорт данных"
      },
      {
        "name": "permission_request",
        "description": "Глобальное создание запросов"
      },
      {
        "name": "permission_review",
        "description": "Глобальная проверка данных"
      },
      {
        "name": "permission_confirm",
        "description": "Глобальное подтверждение данных"
      }
    ]
  },
  "clients": [
    {
      "clientId": "municipal-api",
      "name": "Backend API муниципальной платформы",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "municipal-api-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": false,
      "protocolMappers": [
        {
          "name": "municipal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "municipal-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "municipal-spa",
      "name": "Swagger и SPA муниципальной платформы",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/docs/oauth2-redirect",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:8000",
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "municipal-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "municipal-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-municipal-api",
      "enabled": true,
      "serviceAccountClientId": "municipal-api",
      "realmRoles": [
        "Admin"
      ],
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "view-realm"
        ]
      }
    }
  ]
}
