APP_ENV=local
APP_NAME=API муниципальной low-code платформы
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://lowcode:lowcode@postgres:5432/lowcode
REDIS_URL=redis://redis:6379/0
REDIS_SCHEMA_TTL_SECONDS=3600
RABBITMQ_URL=amqp://lowcode:lowcode@rabbitmq:5672/
IMPORT_QUEUE_NAME=object-imports
EXCEL_EXPORT_QUEUE_NAME=excel-exports
OUTBOX_QUEUE_NAME=platform-events
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1
IMPORT_ASYNC_THRESHOLD=1000
IMPORT_BATCH_SIZE=500
IMPORT_TEMP_PREFIX=imports
EXCEL_MAX_FILE_SIZE_BYTES=31457280
EXCEL_MAX_SHEETS=20
EXCEL_MAX_ROWS=50000
EXCEL_EXPORT_MAX_ROWS=500000
EXCEL_EXPORT_TTL_HOURS=24
EXCEL_MAX_COLUMNS=200
EXCEL_MAX_UNCOMPRESSED_BYTES=209715200
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
ADMIN_ROLE_NAME=Admin
DEFAULT_USER_ROLE_NAME=User
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_REALM=municipal-low-code
KEYCLOAK_API_CLIENT_ID=municipal-api
KEYCLOAK_API_AUDIENCE=municipal-api
KEYCLOAK_API_CLIENT_SECRET=municipal-api-secret
KEYCLOAK_SWAGGER_CLIENT_ID=municipal-spa

POSTGRES_DB=lowcode
POSTGRES_USER=lowcode
POSTGRES_PASSWORD=lowcode

KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=admin

DADATA_API_KEY=
DADATA_SECRET_KEY=
DADATA_SUGGESTIONS_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/address
NOMINATIM_URL=http://nominatim:8080
NOMINATIM_PUBLIC_URL=http://localhost:8081
GEOCODING_DEFAULT_LIMIT=10

NOMINATIM_PORT=8081
NOMINATIM_PBF_URL=https://download.geofabrik.de/russia/volga-fed-district-latest.osm.pbf
NOMINATIM_REPLICATION_URL=
NOMINATIM_UPDATE_MODE=none
NOMINATIM_FREEZE=true
NOMINATIM_IMPORT_WIKIPEDIA=false
NOMINATIM_PASSWORD=nominatim
NOMINATIM_THREADS=4

RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=lowcode
RABBITMQ_DEFAULT_PASS=lowcode
RABBITMQ_DEFAULT_VHOST=/
